# Copy to .env and adjust. Never commit real secrets.

# Primary SQLAlchemy URL (preferred by runtime). Use postgresql+psycopg:// for PostgreSQL.
DATABASE_URL=postgresql+psycopg://recklock:change-me@localhost:5432/recklock

# Deployment label (logging, ops).
RECKLOCK_ENV=production

# HTTP bind address & port for `recklock-registry serve`.
RECKLOCK_API_HOST=0.0.0.0
RECKLOCK_API_PORT=8080

# Working directory for registry files (manifests, index.json, logs).
RECKLOCK_REGISTRY_ROOT=/data/registry

# Allow real outbound connector execution (disabled by default).
RECKLOCK_ENABLE_REAL_CONNECTORS=false

# Optional: reserved for future signed-session / cookie signing (not required today).
# RECKLOCK_SECRET_KEY=
